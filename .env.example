# Copy to .env and fill in. Never commit .env.

# Garmin Connect web -> Settings -> Personal API Key (shown only once when created)
GARMIN_API_KEY=
# The expiry date you chose for the key (YYYY-MM-DD); used to warn before it lapses
GARMIN_API_KEY_EXPIRES=

# Public Tailscale Funnel origin, no trailing slash. Used as the MCP OAuth issuer.
PUBLIC_BASE_URL=https://your-host.your-tailnet.ts.net

# At least 16 characters. Guards /admin/* (HTTP Basic, any username) and the public
# /mcp-login page that approves claude.ai's access.
ADMIN_PASSWORD=

# Paths (docker-compose overrides these to the container volumes)
DATABASE_PATH=data/garmin.db
BACKUP_DIR=backups

# Optional
# SYNC_INTERVAL_MINUTES=60
# SYNC_LOOKBACK_DAYS=3
# BACKUP_KEEP=14
# JOBS_ENABLED=true
# MCP_ALLOWED_REDIRECT_URIS=["https://claude.ai/api/mcp/auth_callback"]
