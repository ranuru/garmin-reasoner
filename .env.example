# Copy to .env and fill in. Never commit .env.

# From the Garmin developer portal
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Public Tailscale Funnel origin, no trailing slash. Used as the MCP OAuth issuer.
PUBLIC_BASE_URL=https://your-host.your-tailnet.ts.net
# Must also be registered in the Garmin developer portal
REDIRECT_URI=https://your-host.your-tailnet.ts.net/callback

# At least 16 characters. Guards /connect and /admin/* (HTTP Basic, any username)
# and the public /mcp-login page that approves claude.ai's access.
ADMIN_PASSWORD=

# Paths (docker-compose overrides these to the container volumes)
DATABASE_PATH=data/garmin.db
BACKUP_DIR=backups

# Optional
# BACKUP_KEEP=14
# GAP_CHECK_DAYS=30
# JOBS_ENABLED=true
# GARMIN_AUTHORIZE_URL=https://connect.garmin.com/oauth2Confirm
# GARMIN_TOKEN_URL=https://diauth.garmin.com/di-oauth2-service/oauth/token
# MCP_ALLOWED_REDIRECT_URIS=["https://claude.ai/api/mcp/auth_callback"]
