# Copy to .env and fill in. Never commit .env.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Password for admin routes (/connect, /admin/*), sent via HTTP Basic auth
ADMIN_PASSWORD=
# Public Tailscale Funnel URL registered in the Garmin developer portal
REDIRECT_URI=https://your-host.your-tailnet.ts.net/callback
# Path to the SQLite database file
DATABASE_PATH=data/garmin.db
# Garmin OAuth endpoints; defaults are in config.py. Override if your portal docs differ.
# GARMIN_AUTHORIZE_URL=https://connect.garmin.com/oauth2Confirm
# GARMIN_TOKEN_URL=https://diauth.garmin.com/di-oauth2-service/oauth/token
